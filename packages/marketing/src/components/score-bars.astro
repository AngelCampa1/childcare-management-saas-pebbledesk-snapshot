---
interface ScoreItem {
	label: string
	score?: number
	valueLabel?: string
	note?: string
}

interface Props {
	title?: string
	items?: ScoreItem[]
}

const {
	title = "Selection snapshot",
	items = [
		{ label: "Audit readiness", valueLabel: "Strong fit", note: "Records stay tied to daily activity." },
		{ label: "Director speed", valueLabel: "Scan-first", note: "Designed for quick director decisions." },
		{ label: "Subsidy support", valueLabel: "Visible", note: "Claim support remains easy to review." },
	],
} = Astro.props
---

<aside data-score-bars class="rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--surface-secondary)] p-5">
	<h2 class="font-heading text-lg font-bold text-[var(--color-brand-text)]">{title}</h2>
	<div class="mt-5 space-y-4">
		{items.map((item) => (
			<div>
				<div class="flex items-center justify-between gap-3">
					<p class="text-sm font-semibold text-[var(--color-brand-text)]">{item.label}</p>
					<p class="text-right text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-700)]">
						{typeof item.score === "number" ? `${item.score}/100` : item.valueLabel}
					</p>
				</div>
				<div class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--surface-elevated)]">
					<div
						class="h-full rounded-full bg-[var(--color-accent-500)]"
						style={`width: ${typeof item.score === "number" ? Math.max(0, Math.min(100, item.score)) : 100}%`}
					></div>
				</div>
				{item.note && <p class="mt-2 text-xs leading-5 text-[var(--color-brand-muted)]">{item.note}</p>}
			</div>
		))}
	</div>
</aside>
