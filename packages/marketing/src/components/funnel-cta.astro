---
import { buildCtaAnalyticsAttributes } from "../lib/cta-analytics"
import { resolveFunnelConfig } from "../lib/funnel-cta-utils"
import { CheckIconHidden } from "../lib/icons"
import { resolvePublicSignupCta } from "../lib/public-signup-cta"
import type { BuyerStage, FunnelStage } from "../types"

interface Props {
  stage: BuyerStage
  funnel: Record<BuyerStage, FunnelStage>
  sourcePage?: string
  heading?: string
  trustNote?: string
  secondaryCtaText?: string
  secondaryCtaTarget?: string
  subtitle?: string
  benefitBullets?: string[]
}
const { stage, funnel, sourcePage = "/", heading, trustNote, secondaryCtaText, secondaryCtaTarget, subtitle, benefitBullets } = Astro.props
const config = resolveFunnelConfig(funnel, stage)
const primaryCtaTarget = config
  ? resolvePublicSignupCta({
      sourcePage,
      explicitTarget: config.ctaTarget,
      explicitText: config.ctaText,
    }).target
  : undefined
const primaryAnalyticsAttributes = config
  ? buildCtaAnalyticsAttributes({
      buyerStage: stage,
      intent: config.ctaMode,
      placement: "funnel-primary",
      target: primaryCtaTarget,
    })
  : undefined
const secondaryAnalyticsAttributes =
  secondaryCtaTarget &&
  buildCtaAnalyticsAttributes({
    buyerStage: stage,
    intent: config?.ctaMode,
    placement: "funnel-secondary",
    target: secondaryCtaTarget,
  })
---

{
  config && (
    <section
      class="w-full px-4 py-[var(--section-py-sm)] text-center"
      style="background: var(--section-gradient-cta)"
      data-funnel-cta
      data-section="funnel-cta"
      data-stage={stage}
    >
      <div data-funnel-shell class="mx-auto max-w-5xl">
        {heading && (
          <h2
            class="mb-[var(--component-gap)] font-heading text-[length:var(--text-heading)] font-bold text-brand-text"
          >
            {heading}
          </h2>
        )}
        {benefitBullets && benefitBullets.length > 0 && (
          <ul class="mb-[var(--component-gap)] flex list-none flex-wrap justify-center gap-x-6 gap-y-2 p-0">
            {benefitBullets.map((bullet) => (
              <li class="inline-flex items-center gap-2">
                <span
                  class="inline-flex h-[var(--icon-md)] w-[var(--icon-md)] flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-500)] text-xs font-bold text-[var(--color-neutral-50)]"
                  aria-hidden="true"
                  set:html={CheckIconHidden}
                />
                <span class="text-[length:var(--text-caption)] font-semibold text-brand-text">
                  {bullet}
                </span>
              </li>
            ))}
          </ul>
        )}
        <div class="inline-flex flex-col items-center gap-[var(--component-gap-sm)]">
          <div class="inline-flex flex-col items-center gap-[var(--component-gap-sm)] sm:flex-row">
            {stage === "bofu" ? (
              <a
                href={primaryCtaTarget}
                class="btn-primary btn-primary--pulse btn-shimmer"
                {...primaryAnalyticsAttributes}
              >
                {config.ctaText} -&gt;
              </a>
            ) : (
              <a
                href={primaryCtaTarget}
                class="btn-secondary btn-shimmer"
                {...primaryAnalyticsAttributes}
              >
                {config.ctaText}
              </a>
            )}
            {secondaryCtaText && secondaryCtaTarget && (
              <a
                href={secondaryCtaTarget}
                class="btn-secondary btn-shimmer"
                {...secondaryAnalyticsAttributes}
              >
                {secondaryCtaText}
              </a>
            )}
          </div>
          {subtitle && (
            <p class="mt-2 text-[length:var(--text-caption)] text-brand-muted">{subtitle}</p>
          )}
        </div>
        {trustNote && (stage === "mofu" || stage === "bofu") && (
          <p class="mt-3 font-mono text-[length:var(--text-caption)] text-brand-muted">
            {trustNote}
          </p>
        )}
      </div>
    </section>
  )
}
