---
import BreadcrumbNav from "../components/breadcrumb-nav.astro"
import ContentCard from "../components/content-card.astro"
import FaqSection from "../components/faq-section.astro"
import Pagination from "../components/pagination.astro"
import SiteFooter from "../components/site-footer.astro"
import SiteHeader from "../components/site-header.astro"
import BaseLayout from "../layouts/base-layout.astro"
import { resolveCanonicalUrl } from "../lib/collections"
import { shouldShowFaqsOnPage } from "../lib/hub-utils"
import { composeMetaTitle } from "../lib/meta"
import { resolvePublicSignupCta } from "../lib/public-signup-cta"
import { buildCollectionPageSchema } from "../lib/schema-builders"
import { buildGraph, withId } from "../lib/schema-graph"
import SchemaMarkup from "../seo/schema-markup.astro"
import type { BreadcrumbItem, ContentItem, FaqItem, SiteConfig } from "../types"

interface PageData {
  data: ContentItem[]
  currentPage: number
  lastPage: number
  url: {
    prev: string | undefined
    next: string | undefined
  }
}

interface Props {
  config: SiteConfig
  title: string
  description: string
  items: ContentItem[]
  page: PageData
  basePath: string
  breadcrumbs: BreadcrumbItem[]
  canonicalUrl?: string
  emptyStateHeading?: string
  emptyStateBody?: string
  faqs?: FaqItem[]
  faqHeading?: string
  eyebrow?: string
  variant?: "default" | "editorial"
}

const {
  config,
  title,
  description,
  items,
  page,
  basePath,
  breadcrumbs,
  canonicalUrl,
  emptyStateHeading = "No matching resources found.",
  emptyStateBody = "Try a broader filter or return to the main resource library.",
  faqs = [],
  faqHeading,
  eyebrow,
  variant = "default",
} = Astro.props

const resolvedCanonical =
  canonicalUrl ?? resolveCanonicalUrl(config.domain, basePath, page.currentPage)
const metadataDescription =
  page.currentPage > 1 ? `Page ${page.currentPage}: ${description}` : description
const siteUrl = `https://${config.domain}`
const sourcePage = new URL(resolvedCanonical).pathname
const headerCta = resolvePublicSignupCta({
  sourcePage,
  explicitTarget: config.funnel.bofu.ctaTarget,
  explicitText: config.funnel.bofu.ctaText,
})
const collectionSchema = buildCollectionPageSchema({
  name: title,
  description,
  url: resolvedCanonical,
  items: items.map(item => ({
    name: item.title,
    description: item.description,
    url: `${siteUrl}${item.href}`,
  })),
})
const graph = buildGraph([withId(collectionSchema, `${resolvedCanonical}#collection`)])
const featuredItems = items.slice(0, 3)
---

<BaseLayout
  title={composeMetaTitle(`${title}${page.currentPage > 1 ? ` - Page ${page.currentPage}` : ""}`, config.name)}
  description={metadataDescription}
  canonicalUrl={resolvedCanonical}
  siteName={config.name}
  ogType="website"
  themeColor={config.theme.primary}
  theme={config.theme}
  fonts={config.theme.fonts}
  appleTouchIcon={config.appleTouchIcon}
>
  {page.url.prev && <link slot="head" rel="prev" href={page.url.prev} />}
  {page.url.next && <link slot="head" rel="next" href={page.url.next} />}
  <SiteHeader
    slot="header"
    siteName={config.name}
    navItems={config.nav?.items}
    signInHref={config.nav?.signInHref}
    ctaText={config.nav?.ctaText ?? headerCta.text}
    ctaHref={headerCta.target}
    logoLight={config.logo?.light}
    logoDark={config.logo?.dark}
    promo={config.promoBanner}
  />

  <div
    data-hub-layout
    class:list={[
      "hub-shell mx-auto px-4 py-[var(--section-py-sm)]",
      variant === "editorial" ? "max-w-6xl editorial-shell" : "max-w-5xl",
    ]}
  >
    <div class="hub-intro mb-10">
      <BreadcrumbNav items={breadcrumbs} siteUrl={`https://${config.domain}`} />

      <header
        data-hub-hero
        class:list={[
          "mt-4",
          variant === "editorial"
            ? "max-w-[var(--content-measure-wide)]"
            : "rounded-[var(--radius-xl)] border border-[color-mix(in_srgb,var(--color-neutral-300)_40%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_78%,var(--surface-secondary))] px-6 py-7 shadow-[var(--shadow-card)]",
        ]}
      >
        {eyebrow && variant === "editorial" && <p class="editorial-kicker">{eyebrow}</p>}
        <h1
          class:list={[
            "font-heading font-bold text-[var(--color-brand-text)]",
            variant === "editorial"
              ? "mt-4 text-[length:var(--text-editorial-title)] leading-[1.04]"
              : "mb-3 text-[length:var(--text-heading)]",
          ]}
        >
          {title}
        </h1>
        <p
          class:list={[
            "text-[var(--color-brand-muted)]",
            variant === "editorial"
              ? "editorial-lede"
              : "max-w-2xl text-[length:var(--text-body-lg)]",
          ]}
        >
          {description}
        </p>
        {
          page.lastPage > 1 && (
            <p
              class:list={[
                "text-[length:var(--text-caption)] text-[var(--color-neutral-500)]",
                variant === "editorial"
                  ? "mt-3 font-mono uppercase tracking-[0.12em]"
                  : "mt-3 inline-flex rounded-full bg-[color-mix(in_srgb,var(--surface-elevated)_82%,var(--surface-primary))] px-3 py-1",
              ]}
            >
              Page {page.currentPage} of {page.lastPage}
            </p>
          )
        }
      </header>
    </div>

    <slot name="intro" />
    <slot name="filters" />

    {featuredItems.length > 0 && (
      <section
        data-hub-quick-start
        class="mb-10 rounded-[var(--radius-xl)] border border-[color-mix(in_srgb,var(--color-accent-200)_55%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_88%,var(--color-accent-50))] p-6 shadow-[var(--shadow-card)]"
        aria-labelledby="hub-quick-start-heading"
      >
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] lg:items-start">
          <div class="max-w-2xl">
            <p class="mb-2 text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-700)]">
              Quick start
            </p>
            <h2
              id="hub-quick-start-heading"
              class="font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-brand-text)]"
            >
              Start with the section that matches your job today.
            </h2>
            <p class="mt-2 text-[var(--color-brand-muted)]">
              Use this shortlist when you need an answer in the middle of the workday and do not
              want to dig through every page in the category.
            </p>
          </div>
          <div class="grid gap-3">
            {
              featuredItems.map((item) => (
                <a
                  href={item.href}
                  class="rounded-[var(--radius-lg)] border border-[color-mix(in_srgb,var(--color-neutral-200)_75%,transparent)] bg-white px-4 py-4 transition-[transform,box-shadow,border-color] duration-[var(--transition-base)] hover:-translate-y-0.5 hover:border-[var(--color-accent-400)] hover:shadow-[var(--shadow-card)]"
                >
                  <p class="font-medium text-[var(--color-brand-text)]">{item.title}</p>
                  <p class="mt-1 text-[length:var(--text-caption)] text-[var(--color-brand-muted)]">
                    {item.description}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    )}

    {
      items.length > 0 ? (
        <section aria-label={`${title} listing`}>
          <div data-hub-card-grid class="hub-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
              <ContentCard item={item} />
            ))}
          </div>
        </section>
      ) : (
        <div class="rounded-[var(--radius-xl)] border border-[color-mix(in_srgb,var(--color-neutral-300)_40%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_80%,var(--surface-secondary))] py-16 text-center text-[var(--color-brand-muted)] shadow-[var(--shadow-card)]">
          <p class="mb-2 text-[length:var(--text-body-lg)] font-medium">{emptyStateHeading}</p>
          <p class="text-[length:var(--text-caption)]">
            {emptyStateBody}
          </p>
        </div>
      )
    }

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      basePath={basePath}
    />

    <slot name="cta" />

    {shouldShowFaqsOnPage(faqs, page.currentPage) && (
      <FaqSection
        faqs={faqs}
        heading={faqHeading}
        showBottomCta={false}
        ctaVariant="compact"
      />
    )}
  </div>

  <SiteFooter
    slot="footer"
    siteName={config.name}
    tagline={config.tagline}
    linkGroups={config.footer?.linkGroups}
    legalLinks={config.footer?.legalLinks}
    captureVariant="compact"
  />
  <SchemaMarkup graph={graph} />
</BaseLayout>
