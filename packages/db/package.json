{
	"name": "@pebbledesk/db",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./client": "./src/client.ts"
	},
	"scripts": {
		"test": "vitest run --maxWorkers=1 --pool=forks --no-file-parallelism",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"verify:production-schema": "tsx src/verify-production-schema.ts"
	},
	"dependencies": {
		"@pebbledesk/shared": "workspace:*",
		"postgres": "^3.4.7",
		"drizzle-orm": "^0.45",
		"@neondatabase/serverless": "^1.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "4.1.5",
		"drizzle-kit": "^0.31",
		"tsx": "^4.21.0",
		"typescript": "6.0.3",
		"vitest": "4.1.5"
	}
}
