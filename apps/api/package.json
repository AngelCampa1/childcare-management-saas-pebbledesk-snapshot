{
	"name": "@pebbledesk/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"build": "tsc --noEmit",
		"deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/cloudflare/deploy-api.ps1",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7",
		"@neondatabase/serverless": "^1.0",
		"@pebbledesk/auth": "workspace:*",
		"@pebbledesk/db": "workspace:*",
		"@pebbledesk/emails": "workspace:*",
		"@pebbledesk/shared": "workspace:*",
		"@sentry/cloudflare": "^10.49.0",
		"better-auth": "^1.6.8",
		"drizzle-orm": "^0.45",
		"hono": "^4.12",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4",
		"@types/node": "^25.6.0",
		"typescript": "6.0.3",
		"vitest": "4.1.5",
		"wrangler": "^4.84.1"
	}
}
