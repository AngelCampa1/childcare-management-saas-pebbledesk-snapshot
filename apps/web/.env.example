# PebbleDesk Web App - environment variables
# Copy to apps/web/.env.local for local builds if needed.

# API base URL override. Defaults are handled in code when omitted.
VITE_API_URL=http://localhost:8790

# Optional browser error tracking DSN for the product app.
VITE_SENTRY_DSN=

# Optional PostHog browser analytics. Set production values in Cloudflare/build env.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Base URL for the marketing site. Used to build Terms and Privacy links in the
# signup form. Defaults to https://pebbledesk.app when unset.
# Set to http://localhost:4321 to point at the local marketing site during dev.
VITE_MARKETING_SITE_URL=

# Ventora CRM feedback-button widget. The public widget key is issued by the
# CRM operator and stored here. Leave blank to disable the widget entirely
# (e.g. during local dev without a CRM origin allowlist entry).
# The CRM enforces an authenticated-origin allowlist server-side, so the widget
# fetch no-ops on localhost even when the key is set — this is expected.
# NEVER hardcode a real key in committed files; set it in your .env.local or
# the Cloudflare build environment.
VITE_CRM_WIDGET_KEY=
# Override the CRM loader URL for staging/preview environments.
# Defaults to https://widgets.ventoralabs.com/w/v1.js when unset.
VITE_CRM_LOADER_URL=
