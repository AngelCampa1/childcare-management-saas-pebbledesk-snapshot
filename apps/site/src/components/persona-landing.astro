---
import BreadcrumbNav from "@pebbledesk/marketing/components/breadcrumb-nav.astro";
import FaqSection from "@pebbledesk/marketing/components/faq-section.astro";
import RelatedPages from "@pebbledesk/marketing/components/related-pages.astro";
import StickyMobileCta from "@pebbledesk/marketing/components/sticky-mobile-cta.astro";
import { resolvePublicSignupCta } from "@pebbledesk/marketing/lib/public-signup-cta";
import { PEBBLEDESK_OFFERING } from "@pebbledesk/shared/constants";
import type { SiteConfig } from "@pebbledesk/marketing";
import type { PersonaPage } from "@/config/persona-pages";
import { personaPagesBySlug } from "@/config/persona-pages";

interface Props {
  page: PersonaPage;
  config: SiteConfig;
}

const { page, config } = Astro.props;

const siteUrl = `https://${config.domain}`;

const primaryCta = resolvePublicSignupCta({
  sourcePage: page.route,
  explicitTarget: config.funnel.bofu.ctaTarget,
  explicitText: config.funnel.bofu.ctaText,
});

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Who it's for", href: "/for/" },
  { label: page.navLabel, href: page.route },
];

const relatedPersonaPages = page.relatedPersonaSlugs
  .map((s) => personaPagesBySlug[s])
  .filter((p): p is PersonaPage => p !== undefined);
---

<BreadcrumbNav items={breadcrumbItems} siteUrl={siteUrl} />

<!-- Hero -->
<section class="bg-[var(--surface-primary)] px-4 py-20" data-hero>
  <div class="mx-auto max-w-4xl">
    <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-accent-700)]">
      {page.eyebrow}
    </p>
    <h1 class="mt-4 font-heading text-[length:var(--text-heading)] font-bold text-[var(--color-brand-text)] text-balance">
      {page.headline}
    </h1>
    <p class="mt-4 text-[length:var(--text-body-lg)] leading-8 text-[var(--color-brand-muted)] max-w-2xl">
      {page.subheadline}
    </p>
    <div class="mt-8 flex flex-col gap-4">
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={primaryCta.target} class="btn-primary no-underline">
          {primaryCta.text}
        </a>
      </div>
      <p class="text-[length:var(--text-caption)] text-[var(--color-brand-muted)]">
        {PEBBLEDESK_OFFERING.claims.trialDisclosure}
      </p>
    </div>
    <p class="mt-6 text-sm text-[var(--color-brand-muted)]">{page.trustSignal}</p>
  </div>
</section>

<!-- Problem agitation -->
<section class="bg-[var(--surface-secondary)] px-4 py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-heading text-[length:var(--text-heading)] font-bold text-[var(--color-brand-text)]">
      Sound familiar?
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {page.pains.map((pain) => (
        <article class="rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--site-panel-bg)] p-6 shadow-[var(--shadow-card)]">
          <p class="leading-7 text-[var(--color-brand-muted)]">{pain}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- How PebbleDesk helps -->
<section class="bg-[var(--surface-primary)] px-4 py-20">
  <div class="mx-auto max-w-4xl">
    <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-accent-700)]">
      How PebbleDesk helps
    </p>
    <h2 class="mt-2 font-heading text-[length:var(--text-heading)] font-bold text-[var(--color-brand-text)]">
      Built around what {page.navLabel.toLowerCase()} need every day.
    </h2>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {page.helps.map((help) => (
        <article class="rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--site-panel-bg)] p-6 shadow-[var(--shadow-card)]">
          <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-brand-text)]">
            {help.title}
          </h3>
          <p class="mt-3 leading-7 text-[var(--color-brand-muted)]">{help.body}</p>
          <ul class="mt-5 space-y-3">
            {help.links.map((link) => (
              <li>
                <a
                  class="-mx-2 flex min-h-11 items-center rounded-md px-2 py-2 font-medium text-[var(--color-brand-text)] no-underline transition-colors hover:bg-[var(--site-soft-surface)] hover:text-[var(--color-accent-700)]"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Key takeaways -->
<section class="bg-[var(--surface-secondary)] px-4 py-16">
  <div class="mx-auto max-w-4xl">
    <p class="editorial-kicker">Key takeaways</p>
    <ul class="mt-6 space-y-4">
      {page.takeaways.map((item) => (
        <li class="flex gap-3">
          <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-[var(--color-accent-700)]" aria-hidden="true"></span>
          <span class="leading-7 text-[var(--color-brand-muted)]">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Plan fit -->
<section class="bg-[var(--surface-primary)] px-4 py-10">
  <div class="mx-auto max-w-4xl">
    <div class="rounded-[var(--radius-lg)] border border-[var(--site-chip-border)] bg-[var(--site-chip-bg)] px-4 py-3 text-[length:var(--text-caption)] text-[var(--color-brand-text)] shadow-[var(--shadow-card)]">
      <span class="font-semibold">Plan fit:</span> {page.planFit}
    </div>
    <div class="mt-3 rounded-[var(--radius-lg)] border border-[var(--site-chip-border)] bg-[var(--site-chip-bg)] px-4 py-3 text-[length:var(--text-caption)] text-[var(--color-brand-text)] shadow-[var(--shadow-card)]">
      {PEBBLEDESK_OFFERING.claims.trialDisclosure}
    </div>
  </div>
</section>

<!-- Related pages -->
<div class="bg-[var(--surface-secondary)]">
  <RelatedPages pages={page.crossLinks} heading="Compare and dig deeper" />
</div>

<!-- Also built for -->
<section class="bg-[var(--surface-primary)] px-4 py-16">
  <div class="mx-auto max-w-4xl">
    <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-accent-700)]">
      Also built for
    </p>
    <h2 class="mt-2 font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-brand-text)]">
      PebbleDesk works across every program type.
    </h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {relatedPersonaPages.map((related) => (
        <a
          href={related.route}
          class="group rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--site-panel-bg)] p-6 no-underline shadow-[var(--shadow-card)] transition-colors hover:border-[var(--color-accent-400)]"
        >
          <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-accent-700)]">
            {related.eyebrow}
          </p>
          <h3 class="mt-2 font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-brand-text)] group-hover:text-[var(--color-accent-700)]">
            {related.navLabel}
          </h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-brand-muted)]">{related.trustSignal}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<div class="bg-[var(--surface-secondary)]">
  <FaqSection
    faqs={page.faqs}
    bottomCtaHeading="Ready to see how it works?"
    bottomCtaText={primaryCta.text}
    bottomCtaTarget={primaryCta.target}
  />
</div>

<!-- Final CTA band -->
<section class="px-4 py-24" style="background: var(--site-cta-band);" id="signup">
  <div class="mx-auto max-w-5xl rounded-[var(--radius-xl)] border border-[var(--site-cta-band-border)] bg-[color-mix(in_srgb,var(--surface-primary)_14%,transparent)] px-6 py-8 text-center shadow-[var(--shadow-card)]">
    <h2 class="mx-auto mt-3 max-w-3xl font-[family-name:var(--font-heading)] text-[32px] font-bold leading-tight text-[var(--site-cta-text)]">
      Keep your records ready before anyone asks.
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-[var(--site-cta-muted)]">
      Start your {PEBBLEDESK_OFFERING.trial.label}. No credit card required.
    </p>
    <div class="mb-6 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={primaryCta.target} class="btn-primary no-underline">
        {primaryCta.text}
      </a>
    </div>
    <p class="font-[family-name:var(--font-mono)] text-[length:var(--text-kicker)] uppercase tracking-wider text-[var(--site-cta-muted)]">
      {PEBBLEDESK_OFFERING.claims.trialDisclosure}
    </p>
  </div>
</section>

<StickyMobileCta
  ctaText={primaryCta.text}
  ctaTarget={primaryCta.target}
  ctaAction="link"
/>
