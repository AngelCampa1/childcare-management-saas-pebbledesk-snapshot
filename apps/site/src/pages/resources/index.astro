---
import "../../styles/global.css";
import type { CategorySummary } from "@pebbledesk/marketing";
import PublicSignupCta from "@pebbledesk/marketing/components/public-signup-cta";
import ContentHub from "@pebbledesk/marketing/hubs/content-hub.astro";
import { hubFaqs } from "@/config/hub-faqs";
import { resourceHubs } from "@/config/resource-hubs";
import { siteConfig } from "@/config/site";
import { filterItemsForHub, loadHubPageItems } from "@/lib/resource-hub-items";

const items = await loadHubPageItems();

const categories: CategorySummary[] = [
  ...resourceHubs.map((hub) => ({
    name: hub.navLabel,
    description: hub.description,
    href: hub.href,
    count: filterItemsForHub(items, hub.id).length,
  })),
];
---

<ContentHub
  config={siteConfig}
  title="Resources"
  description="Find the hub that matches the childcare paperwork, software, billing, staffing, or local compliance problem in front of you."
  categories={categories}
  canonicalUrl={`https://${siteConfig.domain}/resources`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/resources" },
  ]}
  browseLinkText="Open path ->"
  itemNoun="resource"
  categoryNoun="hub"
  categoryNounPlural="hubs"
  faqs={hubFaqs["/resources"]}
>
  <div
    slot="extra"
    class="mt-12 grid gap-4 rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--site-panel-bg)] p-6 shadow-[var(--shadow-card)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)]"
  >
    <div>
      <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-accent-700)]">
        Triage first
      </p>
      <h2 class="mt-2 text-xl font-bold text-[var(--color-brand-text)]">
        Find the resource hub that matches the paperwork problem in front of you.
      </h2>
      <p class="mt-4 text-[var(--color-brand-muted)] leading-7">
        PebbleDesk organizes every public guide, best list, free tool, feature page, comparison,
        pricing breakdown, state guide, and city guide into a smaller set of practical hubs.
      </p>
    </div>
    <div class="rounded-[var(--radius-lg)] border border-[var(--site-soft-outline)] bg-[var(--site-soft-surface)] px-5 py-5">
      <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-[0.18em] text-[var(--color-brand-muted)]">
        Use this order
      </p>
      <ul class="mt-3 space-y-3 text-[length:var(--text-caption)] leading-6 text-[var(--color-brand-muted)]">
        <li>Use compliance hubs when licensing, ratio, or audit pressure is driving the work.</li>
        <li>Use money hubs when subsidy, billing, pricing, or vendor comparison questions are active.</li>
        <li>Use operations hubs when staff workflow, buying, or rollout decisions need a clearer path.</li>
      </ul>
    </div>
  </div>

  <section
    slot="cta"
    class="mt-10 border-t border-[var(--site-section-rule)] pt-10"
    id="signup"
  >
    <div class="rounded-[var(--radius-xl)] border border-[var(--site-panel-border)] bg-[var(--site-editorial-wash)] px-6 py-8 text-center shadow-[var(--shadow-card)]">
      <h2 class="text-2xl font-bold text-[var(--color-brand-text)]">
        Want the shortlist to turn into a working center setup?
      </h2>
      <p class="mx-auto mb-6 mt-3 max-w-2xl text-[var(--color-brand-muted)] leading-7">
        Pick the plan that fits your center and continue into the PebbleDesk setup flow with ratios,
        attendance, subsidy support, and audit-ready records in one place.
      </p>
      <PublicSignupCta
        client:load
        sourcePage="/resources"
        buttonText="Create Account"
      />
    </div>
  </section>
</ContentHub>
