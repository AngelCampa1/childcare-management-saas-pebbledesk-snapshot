---
import "../../../styles/global.css"
import { getCollection, render } from "astro:content"
import FaqSection from "@pebbledesk/marketing/components/faq-section.astro"
import FunnelCta from "@pebbledesk/marketing/components/funnel-cta.astro"
import InlineSignup from "@pebbledesk/marketing/components/inline-signup.astro"
import RelatedPages from "@pebbledesk/marketing/components/related-pages.astro"
import ArticleLayout from "@pebbledesk/marketing/layouts/article-layout.astro"
import AnswerBlock from "@pebbledesk/marketing/seo/answer-block.astro"
import DefinitionBlock from "@pebbledesk/marketing/seo/definition-block.astro"
import ExpertQuote from "@pebbledesk/marketing/seo/expert-quote.astro"
import { inferPageTrack } from "@pebbledesk/marketing/lib/page-track"
import { siteConfig } from "@/config/site"
import { buildGuideBreadcrumbs } from "@/lib/breadcrumbs"
import { buildContentMap, buildOptionalHowToSchema, entrySlug, resolveRelatedLinksWithFallback } from "@/lib/page-helpers"

export async function getStaticPaths() {
  const entries = await getCollection("guides")
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const { title, description, bluf, buyerStage, publishedAt, updatedAt, noindex, faqs, relatedPages, definitions, answers, expertQuotes } = entry.data
const canonicalPath = entry.data.canonicalHref ?? `/resources/guides/${entrySlug(entry)}`
const track = inferPageTrack({ track: entry.data.track, pageType: "guide" })

const [alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, leadMagnets, features] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("state-pages"),
  getCollection("lead-magnets"),
  getCollection("features"),
])
const contentMap = buildContentMap({ alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, leadMagnets, features })
const resolvedRelatedPages = resolveRelatedLinksWithFallback({ currentPath: canonicalPath, relatedPages, contentMap })

const breadcrumbs = buildGuideBreadcrumbs(title, canonicalPath)
const howToSchema = buildOptionalHowToSchema(entry.data.steps, title, description)
---

<ArticleLayout
  title={title}
  description={description}
  bluf={bluf}
  buyerStage={buyerStage}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  noindex={noindex}
  canonicalPath={canonicalPath}
  config={siteConfig}
  breadcrumbs={breadcrumbs}
  schemas={howToSchema ? [howToSchema] : []}
  headings={headings}
  track={track}
  answers={answers?.map(a => ({ question: a.q, answer: a.a }))}
>
  <Content />

  {definitions && definitions.map((d) => (
    <DefinitionBlock term={d.term} definition={d.definition} />
  ))}

  {expertQuotes && expertQuotes.map((q) => (
    <ExpertQuote
      quote={q.quote}
      personName={q.personName}
      jobTitle={q.jobTitle}
      organization={q.organization}
    />
  ))}

  {answers && answers.map((a) => (
    <AnswerBlock question={a.q} answer={a.a} />
  ))}

  <InlineSignup
    sourcePage={canonicalPath}
    heading="Like what you're reading?"
    subtext={siteConfig.funnel.ctaSubtitle}
  />

  <FunnelCta
    stage={buyerStage}
    funnel={siteConfig.funnel}
    sourcePage={canonicalPath}
    heading="Want to learn more?"
    subtitle={siteConfig.funnel.ctaSubtitle}
  />

  <FaqSection faqs={faqs} />

  {resolvedRelatedPages.length > 0 && (
    <RelatedPages
      pages={resolvedRelatedPages}
    />
  )}
</ArticleLayout>
