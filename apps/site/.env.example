# PebbleDesk Marketing Site — environment variables
# Copy to apps/site/.env and fill in for local dev.
# Set PUBLIC_APP_URL to http://localhost:3040 for local dev (points CTAs at local app).

# URL of the product app (used for signup CTA links)
PUBLIC_APP_URL=https://my.pebbledesk.app

# Optional lead capture API origin. Leave blank to use the marketing site's same-origin D1 Worker.
PUBLIC_API_URL=

# Cloudflare Turnstile public site key for the lead-capture forms (build-time).
# Leave blank to render the forms without a Turnstile widget (local dev / tests).
# The matching secret is TURNSTILE_SECRET_KEY (a Worker secret — see .dev.vars.example).
PUBLIC_TURNSTILE_SITE_KEY=

# Optional browser error tracking DSN for the marketing site
PUBLIC_SENTRY_DSN=

# Optional PostHog browser analytics. Set production values in Cloudflare/build env.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Worker error tracking DSN for marketing API routes and scheduled nurture sends.
# In production, set this as a Cloudflare Worker secret named SENTRY_DSN.
SENTRY_DSN=
